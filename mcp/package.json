{
  "name": "@veriport/mcp",
  "version": "0.1.0",
  "description": "MCP server (stdio) for the Veriport API: validate_vat (EU VAT number on VIES with provenance), validate_iban (five checks, SEPA flag), vat_rate (dated, sourced EU VAT rates). No dependency, Node 18+.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "veriport-mcp": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vat",
    "vies",
    "iban",
    "vat-rates",
    "eu-vat"
  ],
  "homepage": "https://veriport.io/docs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "mcpName": "io.veriport/veriport",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenomoung/veriport-sdk",
    "directory": "mcp"
  }
}
